# Leave empty to use the Vite dev proxy (same-origin /api -> API_PROXY_TARGET).
# Set only if the browser should call the backend on a different origin directly;
# that origin then needs to be in the backend's ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api. Change it when the backend is not on
# port 8000 (e.g. uvicorn --port 8001).
API_PROXY_TARGET=http://127.0.0.1:8000
