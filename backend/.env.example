# API 설정
DEBUG=False                              # True면 상세 로그와 자동 리로드
APP_NAME="Knowledge Assist RAG API"
API_PREFIX="/api/v1"                     # 모든 API 경로 앞에 붙는 접두어

# CORS - 프론트엔드 주소를 넣는다. 여기 없는 출처의 브라우저 요청은 거부된다.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# 파일 업로드
MAX_UPLOAD_SIZE=10485760                 # 파일 하나의 최대 크기 (바이트, 기본 10MB)
UPLOAD_DIR="app/storage/uploads"         # 업로드 원본 보관 경로

# 벡터 저장소
CHROMA_PERSIST_DIR="app/storage/chroma_db"  # ChromaDB 영속 디렉터리
COLLECTION_NAME="documents_kure_v1"      # 컬렉션 이름. 임베딩 모델을 바꾸면 함께 바꿔야 한다

# 임베딩
EMBEDDING_MODEL="nlpai-lab/KURE-v1"      # 한국어 특화 임베딩 모델
EMBEDDING_DEVICE="cuda"                  # cpu, cuda, cuda:0 ... cpu로 두면 크게 느려진다

# LLM
LLM_PROVIDER="ollama"                    # 현재 ollama만 지원
OLLAMA_BASE_URL="http://192.168.0.169:11434"  # Ollama 서버 주소. 원격 호스트가 기본값이다
LLM_MODEL="gemma4:26b-a4b-it-q4_K_M"     # Ollama에 받아둔 모델 이름
LLM_TEMPERATURE=0.0                      # 0에 가까울수록 일관된 답변
MAX_TOKENS=1000000                       # 답변 최대 길이(토큰). 작으면 답변이 중간에 잘린다
LLM_MAX_ATTEMPTS=3                       # 접속 실패·타임아웃 시 재시도 횟수. 1이면 재시도 안 함

# OCR - PDF 안의 이미지 영역을 인식한 텍스트로 대체한다
OCR_ENABLED=True                         # 끄면 도표 속 글자는 검색되지 않는다
OCR_REC_MODEL="korean_PP-OCRv5_mobile_rec"  # 문자 인식 모델
OCR_DET_MODEL="PP-OCRv5_mobile_det"      # 문자 영역 검출 모델
OCR_DEVICE="cpu"                         # cpu, gpu, gpu:0 ... gpu는 paddlepaddle-gpu 설치가 전제다
OCR_ISOLATE_PROCESS=True                 # OCR을 별도 프로세스로 격리. torch와 같은 프로세스면 죽는다
OCR_TIMEOUT=120                          # 이미지 한 장 제한 시간(초). 넘기면 워커를 재시작한다
OCR_MIN_SCORE=0.5                        # 이 신뢰도 미만의 인식 결과는 버린다
OCR_BLOCK_PREFIX="[이미지 텍스트]"        # 인식된 텍스트 앞에 붙는 표시. 프롬프트가 이 값으로 OCR 구간을 구분한다

# MinerU - PDF 레이아웃·표·수식 파싱 서비스
MINERU_BASE_URL="http://127.0.0.1:8100"  # MinerU 서버 주소
MINERU_TIMEOUT=300                       # 제한 시간(초). 큰 PDF는 OCR 한 장보다 훨씬 오래 걸린다
MINERU_ENABLED=True                      # 끄면 pypdf로 평문만 추출한다(표·도표 정보 손실)
MINERU_LANG_LIST=["korean"]              # MinerU /file_parse에 그대로 넘어간다. JSON 배열이어야 한다

# RAG
CHUNK_SIZE=1000                          # 청크 목표 크기(글자). 분할 전 페이지 병합 기준도 겸한다
CHUNK_OVERLAP=200                        # 인접 청크가 겹치는 글자 수. 경계에서 문맥이 끊기는 것을 줄인다
RETRIEVAL_K=10                           # 질문 하나에 검색할 청크 수
RETRIEVAL_REORDER=true                   # 관련성 높은 청크를 컨텍스트 앞/뒤 끝에 배치 (Lost in the Middle 완화)

# 청킹 전략
CHUNKING_STRATEGY="default"              # default(고정 길이) | semantic(의미 경계에서 분할)
SEMANTIC_CHUNKER_BREAKPOINT_PERCENTILE=95.0  # semantic 전용. 이 백분위를 넘는 의미 거리에서 청크를 끊는다
SEMANTIC_CHUNKER_MIN_CHUNK_CHARS=200     # semantic 전용. 이보다 짧은 청크가 나올 경계는 건너뛴다

# 동시에 보관할 수 있는 문서 수 상한
MAX_DOCUMENTS=10
