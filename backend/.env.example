# API Configuration
DEBUG=False
APP_NAME="Knowledge Assist RAG API"
API_PREFIX="/api/v1"

# CORS - Add your frontend URL
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR="app/storage/uploads"

# Vector Store
CHROMA_PERSIST_DIR="app/storage/chroma_db"
COLLECTION_NAME="documents_kure_v1"

# Embeddings
EMBEDDING_MODEL="nlpai-lab/KURE-v1"

# LLM Configuration
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://192.168.0.169:11434"
LLM_MODEL="gemma4:26b-a4b-it-q4_K_M"
LLM_TEMPERATURE=0.0
MAX_TOKENS=2000

# OCR - PDF image regions are replaced by their recognised text
OCR_ENABLED=True
OCR_REC_MODEL="korean_PP-OCRv5_mobile_rec"
OCR_DET_MODEL="PP-OCRv5_mobile_det"
OCR_DEVICE="cpu"          # cpu, gpu, gpu:0 ...
OCR_ISOLATE_PROCESS=True  # Run OCR in its own process (required alongside torch)
OCR_TIMEOUT=120           # Seconds per image before the worker is restarted
OCR_MIN_SCORE=0.5         # Drop recognitions below this confidence
OCR_DPI=200               # Render resolution for image regions
OCR_MIN_IMAGE_SIZE=40     # Skip icons/rules smaller than this (pt)
OCR_PAGE_TEXT_THRESHOLD=30  # Fewer native chars => OCR the whole page
OCR_BLOCK_PREFIX="[이미지 텍스트]"

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
