# API Configuration
DEBUG=False
APP_NAME="Knowledge Assist RAG API"
API_PREFIX="/api/v1"

# CORS - Add your frontend URL
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR="app/storage/uploads"

# Vector Store
CHROMA_PERSIST_DIR="app/storage/chroma_db"
COLLECTION_NAME="documents_kure_v1"

# Embeddings
EMBEDDING_MODEL="nlpai-lab/KURE-v1"
EMBEDDING_DEVICE="cuda"   # cpu, cuda, cuda:0 ...

# LLM Configuration
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://192.168.0.169:11434"
LLM_MODEL="gemma4:26b-a4b-it-q4_K_M"
LLM_TEMPERATURE=0.0
MAX_TOKENS=2000

# OCR - PDF image regions are replaced by their recognised text
OCR_ENABLED=True
OCR_REC_MODEL="korean_PP-OCRv5_mobile_rec"
OCR_DET_MODEL="PP-OCRv5_mobile_det"
OCR_DEVICE="cpu"          # cpu, gpu, gpu:0 ...
OCR_ISOLATE_PROCESS=True  # Run OCR in its own process (required alongside torch)
OCR_TIMEOUT=120           # Seconds per image before the worker is restarted
OCR_MIN_SCORE=0.5         # Drop recognitions below this confidence
OCR_BLOCK_PREFIX="[이미지 텍스트]"

# MinerU (PDF layout/table/formula parsing service)
MINERU_BASE_URL="http://127.0.0.1:8100"
MINERU_TIMEOUT=300        # Seconds; large PDFs take longer than a single OCR call
MINERU_ENABLED=True
MINERU_LANG_LIST=["korean"]  # Passed to MinerU's /file_parse form field; must be a JSON array

# RAG Configuration
CHUNK_SIZE=1000        # Also the target size when merging pages before splitting
CHUNK_OVERLAP=200
RETRIEVAL_K=10
RETRIEVAL_REORDER=true  # 관련성 높은 청크를 컨텍스트 앞/뒤 끝에 배치 (Lost in the Middle 완화)

# Chunking strategy
CHUNKING_STRATEGY="default"  # default | semantic
SEMANTIC_CHUNKER_BREAKPOINT_PERCENTILE=95.0  # Distances above this percentile start a new chunk
SEMANTIC_CHUNKER_MIN_CHUNK_CHARS=200         # Breakpoints that would emit a shorter chunk are skipped

# Total documents allowed in the system at once
MAX_DOCUMENTS=10
